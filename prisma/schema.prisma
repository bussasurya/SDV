generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  RECEIVED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  CATALOG_MANAGER
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  image        String?
  icon         String?
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
}

model Product {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  sku              String              @unique
  shortDescription String
  fullDescription  String
  mrp              Decimal             @db.Decimal(10, 2)
  sellingPrice     Decimal             @db.Decimal(10, 2)
  stock            Int                 @default(50)
  categoryId       String
  category         Category            @relation(fields: [categoryId], references: [id])
  rating           Float               @default(4.9)
  reviewsCount     Int                 @default(0)
  isBestSeller     Boolean             @default(false)
  isFeatured       Boolean             @default(false)
  isPublished      Boolean             @default(true)
  packSize         String              @default("100 ml")
  traditionalUses  String?
  directionsForUse String?
  dosage           String?
  precautions      String?
  storage          String?
  images           ProductImage[]
  ingredients      ProductIngredient[]
  faqs             ProductFaq[]
  tags             ProductTag[]
  orderItems       OrderItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([sellingPrice])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
}

model ProductIngredient {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  sanskritName String?
  benefits     String?
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       String  // e.g. "skin-glow", "hair-fall", "digestion-acidity"

  @@index([tag])
}

model FinderQuestion {
  id          String         @id @default(cuid())
  step        Int            // Step 1, 2, 3...
  title       String
  subtitle    String?
  multiSelect Boolean        @default(false)
  options     FinderOption[]
}

model FinderOption {
  id          String         @id @default(cuid())
  questionId  String
  question    FinderQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String
  value       String         // e.g. "skin", "hair", "digestion"
  description String?
  iconName    String?
  rules       FinderRule[]
}

model FinderRule {
  id        String       @id @default(cuid())
  optionId  String
  option    FinderOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  targetTag String       // e.g. "skin-glow", "hair-fall"
  weight    Int          @default(10)
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  validUntil    DateTime?
  isActive      Boolean      @default(true)
  timesUsed     Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([code])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  orders       Order[]
  createdAt    DateTime @default(now())

  @@index([email])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  guestName       String
  guestEmail      String
  guestPhone      String
  shippingAddress String
  city            String
  state           String
  pincode         String
  totalAmount     Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  shippingAmount  Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(RECEIVED)
  paymentMethod   PaymentMethod @default(ONLINE)
  trackingNumber  String?
  couponCode      String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
}

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String    // bcrypt password hash
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())

  @@index([email])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  readTime    String   @default("5 min read")
  excerpt     String
  content     String
  imageUrl    String
  author      String   @default("SDV Ayurvedic Physician")
  isFeatured  Boolean  @default(false)
  publishedAt DateTime @default(now())

  @@index([slug])
}

model SiteContent {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
